{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "AnandADFpractice19june"
		},
		"LS_AzureDataLake_dev_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_AzureDataLake_dev'"
		},
		"LS_AzureSqlDatabase_anand_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSqlDatabase_anand'"
		},
		"LS_AzureDataLake_dev_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://anandradf19sept2026.dfs.core.windows.net/"
		},
		"LS_AzureSqlDatabase_anand_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "adeanandserver.database.windows.net"
		},
		"LS_AzureSqlDatabase_anand_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "anand"
		},
		"LS_AzureSqlDatabase_anand_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Anand.yadav"
		},
		"LS_REST_JSONPLACEHOLDER_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://jsonplaceholder.typicode.com/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "AnandADFpractice19june_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AzureDataLake_dev_accountKey": {
						"value": "[parameters('LS_AzureDataLake_dev_accountKey')]"
					},
					"LS_AzureSqlDatabase_anand_password": {
						"value": "[parameters('LS_AzureSqlDatabase_anand_password')]"
					},
					"LS_AzureDataLake_dev_properties_typeProperties_url": {
						"value": "[parameters('LS_AzureDataLake_dev_properties_typeProperties_url')]"
					},
					"LS_AzureSqlDatabase_anand_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSqlDatabase_anand_properties_typeProperties_server')]"
					},
					"LS_AzureSqlDatabase_anand_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSqlDatabase_anand_properties_typeProperties_database')]"
					},
					"LS_AzureSqlDatabase_anand_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSqlDatabase_anand_properties_typeProperties_userName')]"
					},
					"LS_REST_JSONPLACEHOLDER_properties_typeProperties_url": {
						"value": "[parameters('LS_REST_JSONPLACEHOLDER_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "AnandADFpractice19june_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'AnandADFpractice19june_ArmTemplate_0')]"
			]
		}
	]
}